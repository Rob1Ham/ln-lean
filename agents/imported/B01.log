  P2SH|WITNESS only (kernel/chainparams.cpp:117-118). -/
def BIP16_EXCEPTION_HEIGHT : UInt32 := 170060
def TAPROOT_EXCEPTION_HEIGHT : UInt32 := 692261
def EXCEPTION_HEIGHTS : List UInt32 := [170060, 692261]
