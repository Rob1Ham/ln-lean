      "line": 285
    },
    {
      "id": "LN-BREACH-008",
      "claim": "A confirmed penalty makes the old to_local output unavailable to the breacher.",
      "domain": "Channel",
      "file": "LnLean/Proofs/Channel/BreachProps.lean",
      "line": 306
    },
    {
      "id": "LN-BREACH-009",
      "claim": "A confirmed penalty makes the old to_remote output unavailable to the breacher.",
      "domain": "Channel",
      "file": "LnLean/Proofs/Channel/BreachProps.lean",
      "line": 318
    },
    {
      "id": "LN-BREACH-010",
      "claim": "The sweep is at least the old to_local value minus the fee when to_remote is non-negative.",
