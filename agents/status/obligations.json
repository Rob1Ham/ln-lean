      "file": "LnLean/Proofs/Channel/BreachProps.lean",
      "line": 335
    },
    {
      "id": "LN-BREACH-011",
      "claim": "A valid penalty pays both old main outputs minus the fee, and no more when the fee is non-negative.",
      "domain": "Channel",
      "file": "LnLean/Proofs/Channel/BreachProps.lean",
      "line": 353
    },
    {
      "id": "LN-BREACH-012",
      "claim": "Timely confirmation is exactly the half-open window [breach, breach + window).",
      "domain": "Channel",
      "file": "LnLean/Proofs/Channel/BreachProps.lean",
      "line": 374
    },
    {
      "id": "LN-BREACH-014",
      "claim": "No confirmation at or after the deadline is timely.",
