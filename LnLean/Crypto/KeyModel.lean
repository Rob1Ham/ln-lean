/-
# Secret-key and key-generation model (PR-01)

**English claim.**  The signature interfaces used by the handshake
(`FundingSigningLaw`, `SigningCompleteness`) are keyed directly by the public
key: they assume that "the signer's public key" is enough to produce the honest
signature.  That is an interface stand-in.  This module adds the missing
secret-key and key-generation vocabulary:

* `SecretKey` is an opaque byte string (the model does not do secp256k1
  arithmetic);
* `KeyPair` bundles a secret key with the public key it generates;
* `KeyModel` is a deterministic key-generation function plus an honest signing
  operation and a correctness law on an explicit message domain.

The correctness law is scoped by `correctOn`.  That is deliberate rather than a
convenience: a total correctness law on *all* `ByteArray` messages, together
with the model's message-binding field `EufCma` and a bounded wire encoding,
would force an injection from the countably infinite message space into a
finite set of signatures.  The domain restriction is the honest model of a
signer that is complete on the protocol messages it is specified to sign, and
it keeps the negative result in
`LnLean.Proofs.Crypto.KeyModelTargets` non-vacuous.

**What this module does not claim.**  It does not prove that a public key
identifies its owner, that key generation is injective, or that the model's
ECDSA verifier is key-binding.  Those are separate hypotheses (`KeyBinding` in
`LnLean.Proofs.WaveE.E06`, specialised for `funding_pubkey` by the targets
module).  C3 (`EufCma`) constrains messages under a fixed key; it says nothing
about which key or secret produced a signature.

**BOLT sections.**  BOLT 2 §The `open_channel` Message and §The
`accept_channel` Message (`funding_pubkey`), §The `funding_created` Message and
§The `funding_signed` Message (the funding signatures).

**rust-lightning anchors (commit fe49009).**
* `lightning/src/ln/chan_utils.rs:600-660` — funding key derivation and the
  keys used by funding/commitment signatures.
* `lightning/src/crypto/utils.rs:75-83` — ECDSA signing over a message digest.
* `lightning/src/ln/msgs.rs:3213` — `commitment_signed`; `:3227` —
  `funding_created`; `:3234` — `funding_signed`.

**Not modelled.**  secp256k1 scalar arithmetic, RFC 6979 nonce derivation, DER
encoding, seed entropy, key storage, proof of possession, and the ownership
game.  `generate` is a total function of a byte-string seed; it is not a
randomised key-generation algorithm.
-/

import LnLean.Crypto.Model

namespace LnLean.Crypto

set_option autoImplicit false

open LnLean

/-! ## 1. Keys and key pairs -/

/-- An opaque secret key.  The model does not inspect its bytes; they are only
a handle that witnesses "the same secret key was used". -/
structure SecretKey where
  bytes : ByteArray
deriving Repr, BEq

/-- A generated key pair: the secret key and the public key it determines. -/
structure KeyPair where
  secret : SecretKey
  pubkey : PubKey
deriving Repr, BEq

namespace KeyPair

/-- A key pair determines its public key. -/
@[simp] theorem pubkey_mk (sk : SecretKey) (pk : PubKey) :
    (⟨sk, pk⟩ : KeyPair).pubkey = pk := rfl

/-- A key pair determines its secret key. -/
@[simp] theorem secret_mk (sk : SecretKey) (pk : PubKey) :
    (⟨sk, pk⟩ : KeyPair).secret = sk := rfl

end KeyPair

/-! ## 2. The key model -/

/-- A secret-key/key-generation model on top of a primitive model.

* `generate` is deterministic key generation from a byte-string seed;
* `sign` is the honest signing operation, keyed by the secret key;
* `correctOn` is the message domain on which the signer is complete;
* `verifies` is signing correctness restricted to that domain.

`KeyModel` does **not** contain a key-binding law.  Nothing here says that a
signature accepted under a public key was produced by the secret key paired
with it; that is the explicit `KeyBinding` hypothesis used by the targets. -/
structure KeyModel (M : PrimitiveModel) where
  /-- Deterministic key generation. -/
  generate : ByteArray → KeyPair
  /-- The honest signing operation, keyed by the signer's secret key. -/
  sign : SecretKey → ByteArray → EcdsaSig
  /-- The message domain on which the signer is specified to be complete. -/
  correctOn : ByteArray → Prop
  /-- Signing correctness: on the declared domain, the honest signature
  verifies under the generated public key. -/
  verifies : ∀ (seed : ByteArray) (msg : ByteArray), correctOn msg →
    M.ecdsaVerify (generate seed).pubkey msg (sign (generate seed).secret msg) =
      true

namespace KeyModel

variable {M : PrimitiveModel}

/-- The public key generated by a seed. -/
def publicOfSeed (K : KeyModel M) (seed : ByteArray) : PubKey :=
  (K.generate seed).pubkey

/-- The secret key generated by a seed. -/
def secretOfSeed (K : KeyModel M) (seed : ByteArray) : SecretKey :=
  (K.generate seed).secret

@[simp] theorem publicOfSeed_def (K : KeyModel M) (seed : ByteArray) :
    K.publicOfSeed seed = (K.generate seed).pubkey := rfl

@[simp] theorem secretOfSeed_def (K : KeyModel M) (seed : ByteArray) :
    K.secretOfSeed seed = (K.generate seed).secret := rfl

/-- The generated signature verifies under the generated public key on the
declared domain.  This is the only correctness fact `KeyModel` supplies. -/
theorem verifies_seed (K : KeyModel M) (seed : ByteArray) {msg : ByteArray}
    (h : K.correctOn msg) :
    M.ecdsaVerify (K.publicOfSeed seed) msg
      (K.sign (K.secretOfSeed seed) msg) = true :=
  K.verifies seed msg h

/-- A key model is *total* when its signer is complete on every message.  This
is an explicit property, not a field: it is the strong form used only when a
consumer really needs completeness for arbitrary bytes. -/
def Total (K : KeyModel M) : Prop :=
  ∀ msg : ByteArray, K.correctOn msg

/-- Totality gives unrestricted signing correctness. -/
theorem verifies_of_total (K : KeyModel M) (h : K.Total) (seed : ByteArray)
    (msg : ByteArray) :
    M.ecdsaVerify (K.publicOfSeed seed) msg
      (K.sign (K.secretOfSeed seed) msg) = true :=
  K.verifies_seed seed (h msg)

/-! ## 3. Ownership -/

/-- `Owns K pk sk` records that `(sk, pk)` is a key pair that key generation
can produce.  It is an existential over seeds, not a functional inverse: key
generation need not be injective, and the model does not assume that it is. -/
def Owns (K : KeyModel M) (pk : PubKey) (sk : SecretKey) : Prop :=
  ∃ seed : ByteArray, K.publicOfSeed seed = pk ∧ K.secretOfSeed seed = sk

/-- Every generated key pair is owned by its seed. -/
theorem owns_generated (K : KeyModel M) (seed : ByteArray) :
    K.Owns (K.publicOfSeed seed) (K.secretOfSeed seed) :=
  ⟨seed, rfl, rfl⟩

/-- An owned key pair signs correctly on the declared domain. -/
theorem owns_verifies (K : KeyModel M) {pk : PubKey} {sk : SecretKey}
    (h : K.Owns pk sk) {msg : ByteArray} (hm : K.correctOn msg) :
    M.ecdsaVerify pk msg (K.sign sk msg) = true := by
  obtain ⟨seed, hpk, hsk⟩ := h
  subst hpk
  subst hsk
  exact K.verifies_seed seed hm

end KeyModel

/-! ## 4. A generated signer -/

/-- A signer is a key model together with the seed it was generated from.
Bundling the seed prevents the common error of checking a signature against
"some" public key that is not the one key generation produced. -/
structure Signer (M : PrimitiveModel) where
  model : KeyModel M
  seed : ByteArray

namespace Signer

variable {M : PrimitiveModel}

/-- The signer's advertised public key. -/
def publicKey (s : Signer M) : PubKey :=
  s.model.publicOfSeed s.seed

/-- The signer's secret key. -/
def secret (s : Signer M) : SecretKey :=
  s.model.secretOfSeed s.seed

/-- The signer signs a tagged message with its secret key. -/
def sign (s : Signer M) (msg : ByteArray) : EcdsaSig :=
  s.model.sign s.secret msg

/-- The signer is complete on the model's declared domain. -/
theorem verifies (s : Signer M) {msg : ByteArray}
    (h : s.model.correctOn msg) :
    M.ecdsaVerify s.publicKey msg (s.sign msg) = true :=
  s.model.verifies_seed s.seed h

/-- The signer's public key is owned by its secret key. -/
theorem owns (s : Signer M) :
    s.model.Owns s.publicKey s.secret :=
  s.model.owns_generated s.seed

end Signer

end LnLean.Crypto
